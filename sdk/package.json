{
  "name": "privacy-protocol",
  "version": "0.1.3",
  "description": "Plug-and-play privacy middleware SDK with core primitives and React hooks.",
  "license": "MIT",
  "main": "./dist/index.mjs",
  "module": "./dist/index.mjs",
  "types": "./dist/index.d.mts",
  "exports": {
    ".": {
      "types": "./dist/index.d.mts",
      "browser": "./dist/index.mjs",
      "import": "./dist/index.mjs",
      "default": "./dist/index.mjs"
    },
    "./core": {
      "types": "./dist/core/index.d.mts",
      "browser": "./dist/core/index.mjs",
      "import": "./dist/core/index.mjs",
      "default": "./dist/core/index.mjs"
    },
    "./hooks": {
      "types": "./dist/hooks/index.d.mts",
      "browser": "./dist/hooks/index.mjs",
      "import": "./dist/hooks/index.mjs",
      "default": "./dist/hooks/index.mjs"
    }
  },
  "files": [
    "dist",
    "README.md"
  ],
  "scripts": {
    "build": "tsup --config tsup.config.ts && node ./scripts/build-workers.mjs",
    "clean": "rm -rf dist",
    "pack:check": "npm pack --dry-run",
    "prepublishOnly": "npm run clean && npm run build"
  },
  "dependencies": {
    "@aztec/bb.js": "^0.87.0",
    "@noir-lang/noir_js": "1.0.0-beta.11",
    "ethers": "^6.16.0"
  },
  "peerDependencies": {
    "react": "^18.2.0 || ^19.0.0"
  },
  "devDependencies": {
    "@types/react": "^19.1.13",
    "esbuild": "^0.25.9",
    "react": "^19.2.0",
    "tsup": "^8.5.0",
    "typescript": "^5.9.2"
  }
}
